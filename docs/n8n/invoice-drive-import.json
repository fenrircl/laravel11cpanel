    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const reservation = $('Reservar importación en Laravel').item.json;\nconst extraction = reservation.action === 'skip' ? null : $('Extraer datos del PDF').item.json;\nconst data = extraction?.data || {};\nconst rawName = reservation.action === 'skip'\n  ? reservation.counterparty_name\n  : (data.issuer || data.supplier_name || data.recipient || reservation.counterparty_name);\nconst safeName = String(rawName || 'Sin proveedor')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[\\\\\\/:*?\"<>|#%{}~&']/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 80) || 'Sin proveedor';\nreturn { json: { drive_file_id: $('Buscar PDFs en carpeta Drive').item.json.id, supplier_folder_name: safeName, supplier_parent_id: ( $('Crear carpeta procesados').isExecuted ? $('Crear carpeta procesados').first().json.id : $('Buscar carpeta procesados').first().json.id ) } };"
      },
