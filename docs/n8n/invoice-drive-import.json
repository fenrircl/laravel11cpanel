        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": "Seleccionar Google Drive"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pdf.solidtec.cl/v1/extractions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "document_type",
              "value": "auto"
            },
            {
              "name": "locale",
              "value": "es-CL"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "8a204720-1a7c-4acb-bbef-a12355be1005",
      "name": "Extraer datos del PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bearer API PDF"
        }
      },
      "retryOnFail": true,
      "maxTries": 6,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.document_type === 'invoice' || $json.document_type === 'receipt' || ($json.document_type === 'unknown' && /FACTURA\\s+ELECTR[ÓO]NICA/i.test($json.raw_text || '') && !/COTIZACI[ÓO]N/i.test($json.raw_text || ''))) ? 'invoice' : 'skip' }}",
              "rightValue": "invoice",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "8a204720-1a7c-4acb-bbef-a12355be1006",
      "name": "¿Es factura? Cotizaciones se omiten",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        750,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configurar importación').first().json.laravel_base_url + '/api/v1/automation/ingestions/reserve' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { source: 'drive', external_id: $('Buscar PDFs en carpeta Drive').item.json.id, external_version: $('Buscar PDFs en carpeta Drive').item.json.version || $('Buscar PDFs en carpeta Drive').item.json.modifiedTime, filename: $('Buscar PDFs en carpeta Drive').item.json.name, mime_type: 'application/pdf' } }}",
        "options": {
          "timeout": 30000
        }
      },
