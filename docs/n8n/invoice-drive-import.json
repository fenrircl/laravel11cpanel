    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $('Configurar importación').first().json.gdrive_folder_id + \"' in parents and trashed = false\" }}",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "={{ $('Configurar importación').first().json.gdrive_folder_id }}",
