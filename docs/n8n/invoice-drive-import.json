        "method": "PUT",
        "url": "={{ $('Configurar importación').first().json.laravel_base_url + '/api/v1/automation/ingestions/' + $('Reservar importación en Laravel').item.json.ingestion_id + '/result' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const result = $('Extraer datos del PDF').item.json; const text = result.raw_text || ''; const looksLikeInvoice = result.document_type === 'unknown' && /FACTURA\\s+ELECTR[ÓO]NICA/i.test(text) && !/COTIZACI[ÓO]N/i.test(text); return { adapter_version: 'pdf-api-1.0-to-invoice-v1', ...result, document_type: looksLikeInvoice ? 'invoice' : result.document_type }; })() }}",
        "options": {
          "timeout": 30000
        }
      },
