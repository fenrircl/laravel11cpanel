      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bearer Laravel n8n"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2003",
      "name": "Un PDF por item",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LARAVEL_BASE_URL + '/api/v1/automation/documents/' + $json.file_id + '/download-url' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2004",
      "name": "Solicitar enlace temporal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bearer Laravel n8n"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2005",
      "name": "Descargar desde R2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pdf.solidtec.cl/v1/extractions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "document_type",
              "value": "invoice"
            },
            {
              "name": "locale",
              "value": "es-CL"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2006",
      "name": "Extraer datos PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bearer API PDF"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LARAVEL_BASE_URL + '/api/v1/automation/ingestions/reserve' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {source:'registered_pdf',external_id:String($('Un PDF por item').item.json.file_id),external_version:String($('Un PDF por item').item.json.created_at || ''),invoice_id:$('Un PDF por item').item.json.invoice_id,file_registry_id:$('Un PDF por item').item.json.file_id,filename:$('Un PDF por item').item.json.file_name,mime_type:'application/pdf',size_bytes:$('Un PDF por item').item.json.size} }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2007",
      "name": "Reservar reproceso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Bearer Laravel n8n"
        }
      }
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.LARAVEL_BASE_URL + '/api/v1/automation/ingestions/' + $('Reservar reproceso').item.json.ingestion_id + '/result' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {adapter_version:'pdf-api-1.0-to-invoice-v1',...$('Extraer datos PDF').item.json} }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9a204720-1a7c-4acb-bbef-a12355be2008",
      "name": "Guardar JSON en Laravel",
      "type": "n8n-nodes-base.httpRequest",
